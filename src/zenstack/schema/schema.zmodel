datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The access rules below apply only to a client created with PolicyPlugin, which the `policy`
// targets use. The plain ZenStack targets ignore them.
plugin policy {
  provider = "@zenstackhq/plugin-policy"
}

type Auth {
  id          Int       @id
  tenantId    Int
  @@auth
}

model Customer {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  name        String?
  email       String    // @unique
  address     Address?
  isActive    Boolean   @default(false)
  // The owner the policy targets check. Every seeded row belongs to tenant 1.
  tenantId    Int       @default(1)
  // extraInfo   Json?
  orders      Order[]

  @@allow('all', tenantId == auth().tenantId)
}

model Address {
  id          Int       @id @default(autoincrement())
  street      String?
  city        String?
  postalCode  String?
  country     String?
  customerId  Int       @unique
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@allow('all', customer.tenantId == auth().tenantId)
}

model Order {
  id          Int       @id @default(autoincrement())
  date        DateTime  
  totalAmount Float
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  products    Product[] @relation("OrderProducts")

  @@allow('all', customer.tenantId == auth().tenantId)
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  quantity    Int
  description String?
  orders      Order[]   @relation("OrderProducts")

  // The product catalog is shared by every tenant.
  @@allow('all', true)
}