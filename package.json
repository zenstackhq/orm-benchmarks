{
    "name": "script",
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "npm run start:node",
        "start:node": "npm run build && node --max-old-space-size=4096 dist/main.js",
        "start:bun": "bun src/main.ts",
        "prisma:gen:pg": "prisma generate --schema prisma-pg/schema.prisma",
        "prisma:gen:mysql": "prisma generate --schema prisma-mysql/schema.prisma",
        "prisma:gen:all": "npm run prisma:gen:pg && npm run prisma:gen:mysql",
        "zen:gen": "zen generate --schema src/zenstack/schema/schema.zmodel",
        "website:output": "npx ts-node ./src/lib/website-output --results-directory"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@zenstackhq/orm": "3.10.3",
        "@zenstackhq/plugin-policy": "3.10.3",
        "dotenv": "^16.4.5",
        "drizzle-orm": "0.45.4",
        "fast-csv": "^5.0.1",
        "kysely": "0.29.9",
        "kysely-postgres-js": "5.1.0",
        "mysql2": "^3.10.2",
        "pg": "8.23.1",
        "postgres": "3.4.7",
        "reflect-metadata": "^0.2.2",
        "typeorm": "1.1.3"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@types/faker": "^6.6.9",
        "@types/bun": "1.4.4",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.15.5",
        "@zenstackhq/cli": "3.10.3",
        "drizzle-kit": "0.31.11",
        "prisma": "7.10.1",
        "typescript": "^5.9.3"
    }
}
