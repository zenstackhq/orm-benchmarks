{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "lib": ["esnext"],
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "skipLibCheck": true,
        "types": ["node", "bun"]
    },
    "include": ["src"],
    "exclude": ["src/**/*-mysql.ts", "src/prisma/client-mysql", "src/run-benchmarks-mysql.ts", "src/lib/prepare-mysql.ts"]
}
